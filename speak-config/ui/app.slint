import { Button, VerticalBox, ComboBox, HorizontalBox, ScrollView, LineEdit } from "std-widgets.slint";

export struct VoiceRow { locale: string, voices: [string], identifiers: [string], selected: int }

export component AppWindow inherits Window {
    title: "Speak MCP Configuration";
    preferred-width: 640px;
    preferred-height: 560px;
    min-width: 520px;
    min-height: 520px;
    in-out property <string> rate-text: "185";
    in property <[VoiceRow]> voice-rows;
    callback voice-selected(int, int);

    in-out property <[string]> voicevox_model: ["Loading..."];
    in-out property <int> voicevox_index: 0;
    
    in-out property <[string]> aivis_model: ["Loading..."];
    in-out property <int> aivis_index: 0;
    
    in-out property <string> status_message: "";
    
    callback save_config(int, int); 
    callback refresh_speakers();

    VerticalBox {
        padding: 24px;
        spacing: 0px;
        Text { text: "Engines"; font-size: 16px; height: 24px; }
        Rectangle { height: 12px; }
        HorizontalBox {
            height: 56px;
            padding: 0px;
            spacing: 24px;
            VerticalBox {
              padding: 0px;
              spacing: 6px;
              Text { text: "VOICEVOX"; font-size: 13px; height: 20px; }
              ComboBox {
                height: 30px;
                model: root.voicevox_model;
                current-index <=> root.voicevox_index;
              }
            }
            VerticalBox {
              padding: 0px;
              spacing: 6px;
              Text { text: "Aivis Speech"; font-size: 13px; height: 20px; }
              ComboBox {
                height: 30px;
                model: root.aivis_model;
                current-index <=> root.aivis_index;
              }
            }
        }

        Rectangle {
            height: 49px;
            Rectangle {
                x: parent.width * 0.05;
                y: 24px;
                width: parent.width * 0.9;
                height: 1px;
                background: #808080;
            }
        }
        Text { text: "Voice Settings"; font-size: 16px; height: 24px; }
        Rectangle { height: 12px; }
        ScrollView {
            vertical-stretch: 1;
            min-height: 198px;
            VerticalBox {
                padding: 0px;
                spacing: 12px;
                alignment: start;
                for row[index] in root.voice-rows: HorizontalBox {
                    height: 30px;
                    padding: 0px;
                    spacing: 16px;
                    Text { text: row.locale; width: 100px; vertical-alignment: center; }
                    ComboBox {
                        model: row.voices;
                        current-index: row.selected;
                        selected(value) => { root.voice-selected(index, self.current-index); }
                    }
                }
                HorizontalBox {
                    height: 30px;
                    padding: 0px;
                    spacing: 16px;
                    Text { text: "Rate (WPM)"; width: 100px; vertical-alignment: center; }
                    LineEdit { text <=> root.rate-text; input-type: number; }
                    Button { text: "−"; width: 32px; clicked => { root.rate-text = max(1, root.rate-text.to-float() - 1); } }
                    Button { text: "+"; width: 32px; clicked => { root.rate-text = root.rate-text.to-float() + 1; } }
                }
            }
        }

        Rectangle { height: 20px; }
        HorizontalBox {
            height: 32px;
            padding: 0px;
            spacing: 12px;
            alignment: end;
            Text {
                text: root.status_message;
                horizontal-stretch: 1;
                min-width: 0px;
                vertical-alignment: center;
                overflow: elide;
            }
            Button {
                text: "Refresh";
                clicked => { root.refresh_speakers(); }
            }
            Button {
                text: "Save Settings";
                primary: true;
                clicked => { 
                    root.save_config(root.voicevox_index, root.aivis_index); 
                }
            }
        }
        
    }
}
